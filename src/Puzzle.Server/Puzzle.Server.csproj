<!--
  The server. Slices live as folders inside it - one folder per capability, holding that
  capability's endpoints, actor, documents and domain logic together.

  They are folders rather than projects deliberately: the point of a slice is that a
  change touches one directory, and a directory achieves that without a project file, a
  reference graph and a build node per feature.
-->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>puzzle-server</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Puzzle.Rules\Puzzle.Rules.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="Akka" />
    <PackageReference Include="Akka.Hosting" />
    <PackageReference Include="Fido2.AspNet" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Puzzle.Server.Tests" />
  </ItemGroup>

</Project>
