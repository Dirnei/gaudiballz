<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Deterministic builds. This matters more here than in most projects: level identity is
    (seed, params, generatorVersion), so anything that makes output vary between machines
    is a correctness hazard rather than a nuisance.
  -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <!--
    Test projects live beside the code they test, under src/, so the relaxation that used
    to sit in a tests/ folder is keyed off the project name instead.

    CA1707 forbids underscores in member names. Underscore-separated test names are the
    readable convention for xUnit, and a test name is documentation rather than API.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <NoWarn>$(NoWarn);CA1707</NoWarn>

    <!--
      Microsoft Testing Platform. A test project is a self-hosting executable rather than
      a library a VSTest host loads, which is why OutputType is Exe. `dotnet test` drives
      it through MTP once TestingPlatformDotnetTestSupport is on.
    -->
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

</Project>
